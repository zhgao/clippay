# Copy to .env and fill in values from your PayPal Developer sandbox app
# (https://developer.paypal.com/ -> Apps & Credentials -> Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Base URL for the PayPal API. Sandbox is the default; use
# https://api-m.paypal.com for production (not needed for the hackathon).
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where the SQLite order database lives.
DATABASE_PATH=./data/clippay.db
APP_BRAND_NAME=ClipPay

# --- M2: video pipeline ---
# Google AI Studio API key for Gemini product extraction
# (https://aistudio.google.com/ -> Get API key). Required for extraction;
# without it, uploaded jobs end in status "failed" with a clear error.
GEMINI_API_KEY=
# Gemini model used for extraction.
GEMINI_MODEL=gemini-2.5-flash
# Directory where uploaded videos are stored.
UPLOAD_DIR=./data/uploads
# faster-whisper model size: tiny | base | small | medium | large-v3.
# Downloaded lazily on the first transcription.
WHISPER_MODEL=tiny
