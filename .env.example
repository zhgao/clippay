# Copy to .env and fill in values from your PayPal Developer sandbox app
# (https://developer.paypal.com/ -> Apps & Credentials -> Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Base URL for the PayPal API. Sandbox is the default; use
# https://api-m.paypal.com for production (not needed for the hackathon).
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where the SQLite order database lives.
DATABASE_PATH=./data/clippay.db
APP_BRAND_NAME=ClipPay
